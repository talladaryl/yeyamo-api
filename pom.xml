<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.yeyamo</groupId>
    <artifactId>yeyamo-api-reactor</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>YeYamo API Reactor</name>
    <modules>
        <module>event-contracts</module>
        <module>security-hardening-starter</module>
        <module>config-server</module>
        <module>registry-service</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>user-service</module>
        <module>partner-service</module>
        <module>campaign-service</module>
        <module>ads-delivery-service</module>
        <module>admin-service</module>
        <module>catalog-service</module>
        <module>ingestion-service</module>
        <module>media-service</module>
        <module>content-service</module>
        <module>interaction-service</module>
        <module>moderation-trust-service</module>
        <module>feed-service</module>
        <module>discovery-service</module>
        <module>notification-service</module>
        <module>recommendation-service</module>
        <module>gamification-service</module>
        <module>mission-reward-service</module>
        <module>referral-service</module>
        <module>booking-service</module>
        <module>payment-service</module>
        <module>commerce-service</module>
        <module>ticket-service</module>
        <module>event-service</module>
        <module>analytics-service</module>
        <module>place-service</module>
        <module>messaging-service</module>
        <module>support-service</module>
    </modules>
    <profiles>
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.2.2</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <failOnError>true</failOnError>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                                <format>SARIF</format>
                            </formats>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/security/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>aggregate</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
