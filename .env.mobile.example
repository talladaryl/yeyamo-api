# Configuration publique du client Expo pour un navigateur ou un simulateur iOS
# exécuté sur la même machine que le backend.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8083
EXPO_PUBLIC_MESSAGING_WS_URL=ws://127.0.0.1:8104/ws/messaging
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_APP_ENV=development
# Leave empty until the deployed payment provider has confirmed the exact
# country/operator identifiers. This public UI config must mirror the server's
# PAYMENT_CASH_IN_CAPABILITIES allow-list; it never authorizes a payment.
EXPO_PUBLIC_CASH_IN_OPERATOR_CONFIG=

# Android Emulator ne partage pas le localhost de Windows. Dans ce cas,
# remplacer uniquement les deux hôtes ci-dessus par 10.0.2.2.
#
# Pour un téléphone physique sur le même Wi-Fi, utiliser l'adresse IPv4 LAN
# de la machine (par exemple http://192.168.1.20:8083 et
# ws://192.168.1.20:8104/ws/messaging).
#
# Aucune clé JWT, SMTP, OAuth privée, TURN permanente ou signature de webhook
# ne doit être ajoutée dans une variable EXPO_PUBLIC_*.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=AIzaSyDIfok7LgiSXmtvzJOO8HFQ3x7uh50YBN8
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=AIzaSyCaBCGQ3wJymCRU1ewjWQBEe_hy6dNkTWs
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=778446413243-n8doeltvktle3u4vk3i6h2c6nnru0i3m.apps.googleusercontent.com
