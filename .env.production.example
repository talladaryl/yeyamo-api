# Core infrastructure
POSTGRES_USER=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Spring Cloud Config Server (Git backend)
CONFIG_SERVER_USERNAME=
CONFIG_SERVER_PASSWORD=
CONFIG_GIT_URI=https://github.com/FulCoding/cloud-conf-yeyamo.git
CONFIG_GIT_BRANCH=daryl
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=
CONFIG_ENCRYPT_ENABLED=false
CONFIG_ENCRYPT_KEYSTORE_LOCATION=
CONFIG_ENCRYPT_KEYSTORE_PASSWORD=
CONFIG_ENCRYPT_KEYSTORE_ALIAS=
CONFIG_ENCRYPT_KEYSTORE_SECRET=

# Service discovery and application security
EUREKA_USERNAME=
EUREKA_PASSWORD=
JWT_SECRET=
JWT_AUDIENCE=yeyamo-api
JWT_ISSUER=yeyamo-auth
INTERNAL_SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=

# Initial administrator (optional; enable only for the first deployment)
YEYAMO_BOOTSTRAP_ADMIN_ENABLED=false
YEYAMO_BOOTSTRAP_ADMIN_EMAIL=
YEYAMO_BOOTSTRAP_ADMIN_PASSWORD=

# Email and notifications
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=YeYamo
PUSH_PROVIDER_ACCESS_TOKEN=

# External APIs
GOOGLE_MAPS_SERVER_API_KEY=
# Apple native identity tokens use the iOS bundle identifier as their audience.
APPLE_CLIENT_ID=com.yeyamo.mobile
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_EXPECTED_HOSTNAME=

# Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Payment aggregator and ticket signing
PAYMENT_PROVIDER_NAME=hr-skills-pay
PAYMENT_AGGREGATOR_BASE_URL=https://api.hrskills-pay.com
PAYMENT_AGGREGATOR_KEY_A=
PAYMENT_AGGREGATOR_KEY_B=
PAYMENT_AGGREGATOR_WEBHOOK_SECRET=
# JSON map deployed only after provider confirmation, e.g. {"XX":["provider-operator-id"]}
PAYMENT_CASH_IN_CAPABILITIES=
TICKET_QR_KEY_ID=
TICKET_QR_PRIVATE_KEY_BASE64=
TICKET_QR_PUBLIC_KEY_BASE64=

# Advertising and Dokploy networking
ADS_TOKEN_SECRET=
DOKPLOY_NETWORK=dokploy-network

# Optional operational tuning
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+UseSerialGC
JAVA_CPU_LIMIT=1.0
JAVA_MEMORY_LIMIT=512M
